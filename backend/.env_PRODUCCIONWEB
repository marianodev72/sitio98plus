NODE_ENV=production
PORT=3000

# CORS allowlist (separados por coma si hay más de uno)
CLIENT_ORIGIN=https://viviendas.armada.mil.ar

# Mongo Atlas (USUARIO/PASS fuertes y rotados)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD_FUERTE@HOST/DB?retryWrites=true&w=majority

# Cookies auth (PROD)
AUTH_COOKIE_NAME=token
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true

# JWT (PROD)
JWT_EXPIRES_IN=15m
JWT_ACTIVE_KID=key-actual

# Claves RS256 por path o por env (NO pegar PEM directamente en repo)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
# Alternativa: JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (solo si inyectás desde un secret manager)

# Turnstile (PROD: si lo usás, ponelo; si no, dejalo vacío)
TURNSTILE_SECRET_KEY=
