// backend/routes/authRoutes.js
const express = require("express");
const router = express.Router();

const { verifyTurnstile } = require("../middleware/turnstile");
const authController = require("../controllers/authController");
const authMw = require("../middleware/auth");
const { refreshUserPrivileges } = require("../middleware/refreshUserPrivileges");

function mustFn(name, fn) {
  if (typeof fn !== "function") {
    throw new Error(`[authRoutes] Handler inválido: ${name} is ${typeof fn}`);
  }
  return fn;
}

// ✅ Login público con Turnstile (si no hay secret -> se omite)
router.post(
  "/login",
  mustFn("verifyTurnstile", verifyTurnstile),
  mustFn("authController.login", authController.login)
);

// Logout público
router.post("/logout", mustFn("authController.logout", authController.logout));

// Registro postulante (público)
router.post(
  "/register-postulante",
  mustFn("authController.registerPostulante", authController.registerPostulante)
);

// /me y /refresh
router.get(
  "/me",
  mustFn("authMw.authRequired", authMw.authRequired),
  mustFn("refreshUserPrivileges", refreshUserPrivileges),
  mustFn("authController.me", authController.me)
);

router.post(
  "/refresh",
  mustFn("authMw.authRequired", authMw.authRequired),
  mustFn("refreshUserPrivileges", refreshUserPrivileges),
  mustFn("authController.refresh", authController.refresh)
);

module.exports = router;
